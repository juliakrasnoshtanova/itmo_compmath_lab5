%%{init: {"flowchart": {"nodeSpacing": 24, "rankSpacing": 30, "wrappingWidth": 460}, "themeVariables": {"fontSize": "17px"}}}%%
flowchart TD
    START(["Начало"])
    START --> TITLE["Многочлен Ньютона с разделёнными разностями<br/>newton_razdel(x, y, xx)"]
    TITLE --> INPUT[/"Ввод: x, y, xx"/]
    INPUT --> INIT["Подготовка:<br/>n ← len(x) − 1<br/>tabl ← razdel_raznosti(x, y)"]
    INIT --> CHECK_V{"vybor_newton(x, xx) = 1,<br/>т.е. xx ≤ (x<sub>0</sub> + x<sub>n</sub>) / 2?"}

    CHECK_V -- "Да" --> INIT1["Первая формула (вперёд):<br/>s ← y<sub>0</sub><br/>p ← 1<br/>k ← 1"]
    INIT1 --> CHECK_K1{"k ≤ n?"}
    CHECK_K1 -- "Да" --> BODY1["p ← p · (xx − x<sub>k−1</sub>)<br/>s ← s + tabl<sub>k, 0</sub> · p<br/>k ← k + 1"]
    BODY1 --> CHECK_K1

    CHECK_V -- "Нет" --> INIT2["Вторая формула (назад):<br/>s ← y<sub>n</sub><br/>p ← 1<br/>k ← 1"]
    INIT2 --> CHECK_K2{"k ≤ n?"}
    CHECK_K2 -- "Да" --> BODY2["p ← p · (xx − x<sub>n−k+1</sub>)<br/>s ← s + tabl<sub>k, n−k</sub> · p<br/>k ← k + 1"]
    BODY2 --> CHECK_K2

    BODY1 ~~~ OUT_OK
    BODY2 ~~~ OUT_OK
    CHECK_K1 -- "Нет" --> OUT_OK[/"Вывод: s"/]
    CHECK_K2 -- "Нет" --> OUT_OK
    OUT_OK --> END_OK(["Конец"])
